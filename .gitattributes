# Normalize line endings so Windows and macOS teammates do not fight over every line
* text=auto
*.sh text eol=lf
gradlew text eol=lf
*.bat text eol=crlf

# Binary files (should not be committed, but mark them in case)
*.npz binary
*.npy binary
*.tflite binary
*.db binary
*.png binary
*.jpg binary
*.jar binary
